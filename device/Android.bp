// Bluetooth device static library for target
// ========================================================
cc_library_static {
    name: "libbtdevice_qti",
    defaults: ["fluoride_defaults_qti"],
    local_include_dirs: [
        "include",
    ],
	header_libs: ["commonsys_system_bt_device_inc"],
    srcs: [
        "src/controller.cc",
        "src/esco_parameters.cc",
    ],
    shared_libs: [
        "liblog",
        "libbtconfigstore",
    ],

//ifeq ($(strip $(TARGET_BUILD_VARIANT)),userdebug)
//ifneq ($(strip $(BOARD_HAS_QTI_BT_ROME)),true))
    cflags: [
        "-DQLOGKIT_USERDEBUG",
    ],
//endif
//endif
}

// Bluetooth device unit tests for target
// ========================================================
cc_test {
    name: "net_test_device_qti",
    test_suites: ["device-tests"],
    defaults: ["fluoride_defaults_qti"],
	header_libs: ["commonsys_system_bt_device_inc"],
    srcs: [
        "test/interop_test.cc",
    ],
    shared_libs: [
        "liblog",
        "libdl",
    ],
    static_libs: [
        "libbtdevice_qti",
        "libbtdevice_ext",
        "libbtcore_qti",
        "libosi_qti",
        "libosi-AllocationTestHarness_qti",
        "libcutils",
        "libbluetooth-types",
    ],
}

cc_library_headers {
   name: "commonsys_system_bt_device_inc",
   vendor_available: true,
   header_libs: [
		"opensource_commonsys_bt_ext_all_inc",
		"opensource_commonsys_intf_bluetooth_inc",
		"opensource_commonsys_system_bt_all_inc",
    ],
	export_header_lib_headers: [
	    "opensource_commonsys_bt_ext_all_inc",
		"opensource_commonsys_intf_bluetooth_inc",
		"opensource_commonsys_system_bt_all_inc",
	],
}
