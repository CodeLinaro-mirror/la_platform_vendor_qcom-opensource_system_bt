soong_config_module_type_import {
    from: "vendor/qcom/opensource/commonsys/bluetooth_ext/system_bt_ext/Android.bp",
    module_types: [
         "bluetooth_ext_bredr_vs_btadva_cc_defaults",
    ],
}

bluetooth_ext_bredr_vs_btadva_cc_defaults {
    name: "btadva_audio_hal_int_cc-default",

    soong_config_variables: {
        bredr_or_btadva: {
           btadva: {
	      header_libs: ["bt_adv_audio_all_inc", "bt_adv_audio_vhal_inc",],
           }
       }
   }
}

// Bluetooth Audio library for target
// ========================================================
cc_library_static {
    name: "libbt-audio-hal-interface-qti",
    defaults: ["fluoride_defaults_qti", "btadva_audio_hal_int_cc-default"],
    header_libs: ["opensource_commonsys_bt_ext_all_inc", "opensource_commonsys_system_bt_all_inc", "opensource_btext_vhal_inc", "opensource_commonsys_intf_bluetooth_inc"],
    include_dirs: ["packages/modules/Bluetooth/system/common/"],
    srcs: [
        //"a2dp_encoding.cc",
        //"client_interface.cc",
        //"hearing_aid_software_encoding.cc",
        "aidl/a2dp_encoding.cc",
        "aidl/bluetooth_audio_port_impl.cc",
        "aidl/client_interface.cc",
        "aidl/codec_status.cc",
        //"aidl/hearing_aid_software_encoding.cc",
        //"aidl/le_audio_software.cc",
    ],
    shared_libs: [
        "vendor.qti.hardware.bluetooth_audio@2.1",
        "vendor.qti.hardware.bluetooth_audio@2.0",
        "android.hardware.bluetooth.audio@2.0",
        "android.hardware.bluetooth.audio@2.1",
        "libfmq",
        "android.hardware.bluetooth.audio-V3-ndk",
        "libbinder_ndk",
        "libhidlbase",
    ],
    static_libs: [
        "libosi_qti",
		"bluetooth-protos-singlestack",
    ],
    cflags: [
        "-DBUILDCFG",
	"-Wno-unused-private-field",
    ],
}
